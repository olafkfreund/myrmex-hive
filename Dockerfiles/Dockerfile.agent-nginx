# Stage 1: Build Agent
FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o agent cmd/agent/main.go

# Stage 2: Runtime with Nginx and Python
FROM alpine:latest
RUN apk --no-cache add ca-certificates procps iputils coreutils nginx python3 iproute2

WORKDIR /app
COPY --from=builder /app/agent .

# Create dummy HTML for nginx
RUN mkdir -p /run/nginx /var/www/html && \
    echo "<h1>Nginx running on agent-nginx!</h1>" > /var/www/html/index.html

# Configure nginx
RUN echo 'server { \
    listen 80; \
    root /var/www/html; \
    index index.html; \
    server_name localhost; \
}' > /etc/nginx/http.d/default.conf

# Create entrypoint script to run nginx, python server, and agent
RUN echo -e '#!/bin/sh\n\
nginx\n\
python3 -m http.server --directory /var/www/html 8081 &\n\
exec /app/agent -config /app/agent_config.json\n\
' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
